# Copie para .env; gere segredos locais com scripts/Initialize-Environment.ps1.
POSTGRES_USER=predictive
POSTGRES_PASSWORD=defina_um_segredo_local
POSTGRES_DB=predictive_bi
DATABASE_URL=postgresql+psycopg://predictive:defina_um_segredo_local@127.0.0.1:55432/predictive_bi
N8N_ENCRYPTION_KEY=gere_uma_chave_estavel_com_64_caracteres
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Vazio: seleção automática entre modelos Qwen locais menores que 7 GB.
OLLAMA_MODEL=
MLFLOW_TRACKING_URI=http://127.0.0.1:5010
API_PORT=8100
FRONTEND_PORT=5180
# Backend visual local; no Compose use http://n8n:5678.
N8N_BASE_URL=http://127.0.0.1:5678
